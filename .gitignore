# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Kotlin/JVM daemon leftovers from Android builds
kotlin-compiler-*
kotlin-daemon.*
hsperfdata_*/

# Third-party course material (not ours to publish)
doc/MVC_Architecture_in_Mobile_Application_Development_Guide.pdf

# Flutter crash logs and screenshots
flutter_*.log
flutter_*.png

# Local environment files (see .env.example); never commit real values
.env
.env.*
!.env.example

# Dependencies of the database check harness (tool/db_check)
/tool/db_check/node_modules/
