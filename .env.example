# ShareLoop app configuration. Copy to `.env` (git-ignored) and run:
#
#   flutter run --dart-define-from-file=.env
#
# Everything in this file is compiled into the app, so only put public
# values here. Leave API_BASE_URL empty (or don't pass the file) to run on
# the built-in mock data instead.

# Root of the Laravel API (backend/), including /api:
#   Chrome / Windows desktop:   http://localhost:8000/api
#   Android emulator:           http://10.0.2.2:8000/api
#   Real phone on the same Wi-Fi: http://<your PC's LAN IP>:8000/api
#     (start the backend with: php artisan serve --host=0.0.0.0 --port=8000)
API_BASE_URL=http://localhost:8000/api

# "Sign in with Google": the OAuth *Web* client ID from Google Cloud Console
# (APIs & Services -> Credentials). Not a secret. Leave empty to hide it.
# Its Authorized JavaScript origins must include the address you open the
# app on, e.g. http://localhost:8000 and http://localhost:5000.
GOOGLE_CLIENT_ID=

# "Continue with Facebook": the App ID from developers.facebook.com
# (App settings > Basic). Not a secret; leave empty to hide it.
FACEBOOK_APP_ID=
