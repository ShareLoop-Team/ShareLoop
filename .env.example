# ShareLoop app configuration. Copy to `.env` (git-ignored) and run:
#
#   flutter run --dart-define-from-file=.env
#
# EVERY value in this file is compiled into the app and can be read by
# anyone who has it. Only public client values belong here. NEVER add the
# Supabase service-role/secret key, the database password, or any Firebase
# Admin credential to this file.
#
# Leave both values empty (or don't pass the file) to run on mock data.

# Supabase Dashboard > Project Settings > API > Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Dashboard > Project Settings > API Keys > Publishable key
# (a legacy "anon" key also works)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
